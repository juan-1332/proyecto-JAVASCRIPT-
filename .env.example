# Modo de entorno de la API ("development" | "production")
VITE_API_MODE="development"

# URL base para entorno local (Express en "/api" o JSON Server en "http://localhost:3001")
VITE_API_DEV_URL="/api"

# URL base para producción (API externa o "/api" con respaldo estático en Vercel)
VITE_API_PROD_URL="/api"
